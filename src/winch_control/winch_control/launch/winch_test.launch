<launch>

  <arg name="usb_port"                default="/dev/ttyUSB0"/>
  <arg name="baud_rate"               default="1000000"/>

  <node name="dynamixel_workbench" pkg="dynamixel_workbench_controllers" type="dynamixel_workbench_controllers"
        required="true" output="screen" args="$(arg usb_port) $(arg baud_rate)"/>

  <node name="winch_control_node" pkg="winch_control" type="winch_control.py" output="screen"/>

</launch>
